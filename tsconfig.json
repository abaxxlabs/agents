{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@abaxxlabs/agents": ["src/index.ts"],
      "@abaxxlabs/agents/bootstrap": ["src/bootstrap/index.ts"],
      "@abaxxlabs/agents/id-sdk-mcp": ["src/mcp/id-sdk.ts"],
      "@abaxxlabs/agents/mcp": ["src/mcp/index.ts"],
      "@abaxxlabs/agents/sql": ["src/sql/index.ts"],
      "@abaxxlabs/agents/sqlite": ["src/storage/sqlite/index.ts"],
      "@abaxxlabs/agents/storage": ["src/storage/index.ts"],
      "@abaxxlabs/agents/storage/postgres/*.js": ["src/storage/postgres/*.ts"],
      "@abaxxlabs/agents/dist/storage/postgres/*.js": ["src/storage/postgres/*.ts"],
      "#audit/*.js": ["src/audit/*.ts"],
      "#auth/*.js": ["src/auth/*.ts"],
      "#bootstrap/*.js": ["src/bootstrap/*.ts"],
      "#capability/*.js": ["src/capability/*.ts"],
      "#cli/*.js": ["src/cli/*.ts"],
      "#crypto/*.js": ["src/crypto/*.ts"],
      "#discovery/*.js": ["src/discovery/*.ts"],
      "#encryption/*.js": ["src/encryption/*.ts"],
      "#errors/*.js": ["src/errors/*.ts"],
      "#identity/*.js": ["src/identity/*.ts"],
      "#mcp/*.js": ["src/mcp/*.ts"],
      "#services/*.js": ["src/services/*.ts"],
      "#sql/*.js": ["src/sql/*.ts"],
      "#storage/*.js": ["src/storage/*.ts"],
      "#transport/*.js": ["src/transport/*.ts"],
      "#types/*.js": ["src/types/*.ts"],
      "#config.js": ["src/config.ts"],
      "#did/*.js": ["src/did/*.ts"],
      "#observability/*.js": ["src/observability/*.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/mcp/rest-bridge.ts"
  ]
}
