{
  "name": "agents-plus-smoke",
  "version": "0.1.0",
  "private": true,
  "description": "Consumer-style smoke test app for Agents++ scoped SQL access.",
  "type": "module",
  "scripts": {
    "pretest": "npm --prefix ../.. run build",
    "test": "vitest run",
    "presmoke": "npm --prefix ../.. run build",
    "smoke": "tsx src/smoke.ts",
    "preweb": "npm --prefix ../.. run build",
    "web": "tsx src/web.ts",
    "pretypecheck": "npm --prefix ../.. run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@abaxxtech/agents": "file:../..",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "@types/pg": "8.11.10",
    "tsx": "4.21.0",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vitest": "4.0.18"
  }
}
