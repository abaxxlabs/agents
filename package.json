{
  "name": "@abaxxlabs/agents",
  "version": "0.22.0",
  "packageManager": "bun@1.3.14",
  "description": "Agents++ — encryption-based agent identity and scoped database access for PostgreSQL",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "require": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/cjs/storage/index.js"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/storage/sqlite/index.d.ts",
        "default": "./dist/storage/sqlite/index.js"
      },
      "require": {
        "types": "./dist/storage/sqlite/index.d.ts",
        "default": "./dist/cjs/storage/sqlite/index.js"
      }
    },
    "./bootstrap": {
      "import": {
        "types": "./dist/bootstrap/index.d.ts",
        "default": "./dist/bootstrap/index.js"
      },
      "require": {
        "types": "./dist/bootstrap/index.d.ts",
        "default": "./dist/cjs/bootstrap/index.js"
      }
    },
    "./sql": {
      "import": {
        "types": "./dist/sql/index.d.ts",
        "default": "./dist/sql/index.js"
      },
      "require": {
        "types": "./dist/sql/index.d.ts",
        "default": "./dist/cjs/sql/index.js"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "require": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/cjs/mcp/index.js"
      }
    },
    "./id-sdk-mcp": {
      "import": {
        "types": "./dist/mcp/id-sdk.d.ts",
        "default": "./dist/mcp/id-sdk.js"
      },
      "require": {
        "types": "./dist/mcp/id-sdk.d.ts",
        "default": "./dist/cjs/mcp/id-sdk.js"
      }
    }
  },
  "imports": {
    "#audit/*.js": {
      "types": "./src/audit/*.ts",
      "default": "./dist/audit/*.js"
    },
    "#auth/*.js": {
      "types": "./src/auth/*.ts",
      "default": "./dist/auth/*.js"
    },
    "#bootstrap/*.js": {
      "types": "./src/bootstrap/*.ts",
      "default": "./dist/bootstrap/*.js"
    },
    "#capability/*.js": {
      "types": "./src/capability/*.ts",
      "default": "./dist/capability/*.js"
    },
    "#cli/*.js": {
      "types": "./src/cli/*.ts",
      "default": "./dist/cli/*.js"
    },
    "#crypto/*.js": {
      "types": "./src/crypto/*.ts",
      "default": "./dist/crypto/*.js"
    },
    "#discovery/*.js": {
      "types": "./src/discovery/*.ts",
      "default": "./dist/discovery/*.js"
    },
    "#encryption/*.js": {
      "types": "./src/encryption/*.ts",
      "default": "./dist/encryption/*.js"
    },
    "#errors/*.js": {
      "types": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#identity/*.js": {
      "types": "./src/identity/*.ts",
      "default": "./dist/identity/*.js"
    },
    "#mcp/*.js": {
      "types": "./src/mcp/*.ts",
      "default": "./dist/mcp/*.js"
    },
    "#services/*.js": {
      "types": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    },
    "#sql/*.js": {
      "types": "./src/sql/*.ts",
      "default": "./dist/sql/*.js"
    },
    "#storage/*.js": {
      "types": "./src/storage/*.ts",
      "default": "./dist/storage/*.js"
    },
    "#transport/*.js": {
      "types": "./src/transport/*.ts",
      "default": "./dist/transport/*.js"
    },
    "#types/*.js": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "#config.js": {
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "#did/*.js": {
      "types": "./src/did/*.ts",
      "default": "./dist/did/*.js"
    },
    "#observability/*.js": {
      "types": "./src/observability/*.ts",
      "default": "./dist/observability/*.js"
    },
    "#index.js": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agents": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/mcp/rest-bridge.*",
    "!dist/cjs/mcp/rest-bridge.*",
    "LICENSE",
    "README.md",
    "vendor/id-sdk-mcp",
    "!vendor/id-sdk-mcp/node_modules",
    "!vendor/id-sdk-mcp/sdk/browser.js",
    "!vendor/id-sdk-mcp/sdk/browser.mjs",
    "!vendor/id-sdk-mcp/sdk/browser.mjs.map"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs-shim",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs-shim": "node scripts/gen-cjs-shim.mjs",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "assert:package-artifacts": "node scripts/assert-package-artifacts.mjs",
    "audit:package-files": "node scripts/audit-public-artifacts.mjs package",
    "audit:source-terms": "node scripts/audit-source-blocked-terms.mjs",
    "audit:public-repo": "node scripts/audit-public-artifacts.mjs public-repo",
    "audit:public-artifacts": "node scripts/audit-public-artifacts.mjs all",
    "lint": "eslint src/ test/ --ext .ts",
    "lint:fix": "eslint src/ test/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'packages/server/src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'packages/server/src/**/*.ts'",
    "demo": "node --loader ts-node/esm src/cli/index.ts demo",
    "typecheck": "tsc --noEmit",
    "precommit:typecheck": "npm --prefix packages/server ci --no-audit --no-fund && tsc --noEmit && tsc -p packages/server/tsconfig.typecheck.json",
    "precommit:lint": "npm run lint",
    "precommit:format": "FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts'); [ -z \"$FILES\" ] || prettier --write $FILES",
    "typecheck:user-stories": "tsc -p demo/user-stories/tsconfig.json",
    "release:check-npm-cache": "node scripts/check-npm-cache.mjs",
    "benchmark:query": "npm run build:esm && node scripts/benchmark-query-path.mjs",
    "docs:check-boundary": "node scripts/sync-docs-site.mjs --check",
    "docs:install": "bun install --cwd docs-site",
    "docs:sync": "node scripts/sync-docs-site.mjs",
    "docs:typecheck": "npm --prefix docs-site run typecheck",
    "docs:dev": "npm run docs:sync && npm --prefix docs-site run dev --",
    "docs:build": "npm run docs:sync && npm --prefix docs-site run clean && npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run serve --",
    "check:public-api": "node scripts/check-public-api.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "update:public-api": "node scripts/check-public-api.mjs --update",
    "release:gate": "node scripts/release-gate.mjs",
    "check:version-drift": "npm run release:gate",
    "prepublishOnly": "npm run clean && npm run build && npm run assert:package-artifacts && npm run audit:package-files && npm run check:public-api && npm test"
  },
  "keywords": [
    "agent",
    "identity",
    "DID",
    "verifiable-credentials",
    "encryption",
    "postgres",
    "middleware",
    "scope"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abaxxlabs/agents.git"
  },
  "dependencies": {
    "@abaxxtech/id": "^2.0.11",
    "@chainsafe/libp2p-gossipsub": "8.0.1",
    "@chainsafe/libp2p-noise": "12.0.2",
    "@chainsafe/libp2p-yamux": "4.0.2",
    "@decentralized-identity/ion-pow-sdk": "1.0.17",
    "@decentralized-identity/ion-sdk": "1.0.1",
    "@libp2p/kad-dht": "9.3.8",
    "@libp2p/mplex": "8.0.4",
    "@libp2p/webrtc-star": "7.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/ciphers": "0.4.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@sphereon/pex": "2.1.0",
    "bs58": "4.0.1",
    "buffer": "6.0.3",
    "canonicalize": "2.1.0",
    "commander": "12.1.0",
    "did-jwt": "7.4.7",
    "did-resolver": "4.1.0",
    "dns-packet": "5.6.1",
    "ethers": "6.16.0",
    "ipfs-infura": "1.1.9",
    "jose": "5.10.0",
    "libp2p": "0.45.9",
    "lodash": "4.18.1",
    "ms": "2.1.3",
    "multiformats": "12.1.3",
    "pako": "2.1.0",
    "pkarr": "1.1.1",
    "pubsub-js": "1.9.5",
    "readable-stream": "4.4.2",
    "readable-web-to-node-stream": "3.0.2",
    "uuid": "11.1.1",
    "z32": "1.0.1",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@mattrglobal/bbs-signatures": "2.0.0",
    "level": "8.0.0"
  },
  "//overrides": "Security pins — flat format required by Bun (nested overrides are silently ignored). brace-expansion is pinned to 1.1.14 globally; @typescript-eslint/typescript-estree/minimatch requires ^5.0.2 and Bun satisfies that constraint via nested resolution (5.0.5) rather than the global pin.",
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.15",
    "brace-expansion": "1.1.14",
    "path-to-regexp": "8.4.2",
    "postcss": "8.5.12"
  },
  "peerDependencies": {
    "better-sqlite3": "11.10.0",
    "libpg-query": "17.7.3",
    "pg": "8.20.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "libpg-query": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "better-sqlite3": "11.10.0",
    "eslint": "^9.0.0",
    "express": "^5.2.1",
    "jiti": "2.7.0",
    "libpg-query": "17.7.3",
    "pg": "8.20.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "vite": "6.4.3",
    "vitest": "4.1.0"
  }
}
